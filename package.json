{
  "name": "@hoshinotatsuya/bullmq-kit",
  "version": "0.9.1",
  "description": "Redis-backed concurrency, rate and fair-share limits per group for BullMQ workers, plus orphaned job cleanup, queue inspection, graceful Worker shutdown and a dead-letter queue.",
  "keywords": [
    "bullmq",
    "redis",
    "ioredis",
    "queue",
    "concurrency",
    "rate-limit",
    "fair-share",
    "semaphore",
    "dead-letter",
    "worker",
    "orphaned-jobs",
    "prometheus"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/bullmq-kit.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/bullmq-kit#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/bullmq-kit/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq/index.d.ts",
      "default": "./dist/bullmq/index.js"
    },
    "./orphan-cleanup": {
      "types": "./dist/orphan-cleanup/index.d.ts",
      "default": "./dist/orphan-cleanup/index.js"
    },
    "./inspect": {
      "types": "./dist/inspect/index.d.ts",
      "default": "./dist/inspect/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "bullmq": [
        "./dist/bullmq/index.d.ts"
      ],
      "orphan-cleanup": [
        "./dist/orphan-cleanup/index.d.ts"
      ],
      "inspect": [
        "./dist/inspect/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "lint": "biome check src examples",
    "test": "pnpm run test:latest && pnpm run test:bullmq5 && pnpm run test:bullmq6-oldest && pnpm run test:oldest && pnpm run test:cluster",
    "test:latest": "REDIS_TEST_IMAGE=redis:8-alpine scripts/with-redis.sh jest-groups --out .jest-report.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report.json",
    "test:bullmq5": "BULLMQ_UNDER_TEST=bullmq-5 scripts/with-redis.sh jest-groups --out .jest-report-bullmq5.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report-bullmq5.json",
    "test:bullmq6-oldest": "BULLMQ_UNDER_TEST=bullmq-6-oldest IOREDIS_UNDER_TEST=ioredis-5 REDIS_TEST_IMAGE=redis:8-alpine scripts/with-redis.sh jest-groups --out .jest-report-bullmq6-oldest.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report-bullmq6-oldest.json",
    "test:oldest": "BULLMQ_UNDER_TEST=bullmq-oldest IOREDIS_UNDER_TEST=ioredis-5 scripts/with-redis.sh jest-groups --out .jest-report-oldest.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report-oldest.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:consumers && pnpm run build",
    "test:cluster": "scripts/with-redis-cluster.sh jest-groups --out .jest-report-cluster.json -- node_modules/.bin/jest -c jest.cluster.config.js && jest-assert-no-skipped .jest-report-cluster.json",
    "test:consumers": "scripts/consumer-matrix.sh"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "bullmq": "^5 || ^6",
    "ioredis": "^5 || ^6"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@hoshinotatsuya/jest-groups": "^0.7.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.15",
    "bullmq": "6.7.7",
    "bullmq-5": "npm:bullmq@5.81.5",
    "bullmq-6-oldest": "npm:bullmq@6.0.0",
    "bullmq-oldest": "npm:bullmq@5.72.0",
    "ioredis": "6.0.0",
    "ioredis-5": "npm:ioredis@5.11.1",
    "jest": "30.5.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
